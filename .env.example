# Base URL of the indeed-whatsapp-webhook NestJS backend
BACKEND_API_URL=http://localhost:3111

# Signs the session cookie that tracks which organizations are unlocked in a browser. Unrelated
# to any organization's own secret — rotating this just signs everyone out.
SESSION_SIGNING_SECRET=change_me

# Guards the /platform pages (create/list/rotate/delete organizations). Must match the backend's
# PLATFORM_OWNER_SECRET, and must never equal any organization's own admin secret.
PLATFORM_OWNER_SECRET=change_me
